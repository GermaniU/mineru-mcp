# MinerU MCP Server Configuration

# URL de mineru-api (loopback; en Docker: http://host.docker.internal:8000)
MINERU_URL=http://127.0.0.1:8000

# Scope de systemd de la unit mineru-api para el wake-on-demand y el health:
# user (default) = systemctl --user, system = unit de /etc/systemd/system.
# Cualquier otro valor hace que el server no arranque. Sin systemd no aplica.
# MINERU_SYSTEMCTL_SCOPE=user

# MCP Server Binding Options (solo modo HTTP)
MCP_HOST=0.0.0.0
MCP_PORT=8202

# Optional Bearer token authentication (empty = auth disabled for trusted LAN)
# MCP_AUTH_TOKEN=change-me
